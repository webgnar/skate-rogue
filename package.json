{
  "name": "gnar-run",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts",
    "playtest": "node scripts/playtest/run.mjs",
    "playtest:quick": "node scripts/playtest/run.mjs --quick",
    "playtest:sim": "node scripts/playtest/run.mjs --sim-only",
    "perf": "node scripts/playtest/perf.mjs"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
