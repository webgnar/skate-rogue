{
  "name": "skate-escape",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && node scripts/crazygames/pack.mjs",
    "build:ios": "tsc --noEmit && vite build --mode ios && node scripts/ios/pack.mjs && cap sync ios",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts",
    "playtest": "node scripts/playtest/run.mjs",
    "playtest:quick": "node scripts/playtest/run.mjs --quick",
    "playtest:sim": "node scripts/playtest/run.mjs --sim-only",
    "perf": "node scripts/playtest/perf.mjs",
    "zfight": "node scripts/zfight/run.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
